{
  "title": "Raccourcis",
  "hotkey": "Ctrl+Alt+W",
  "font": { "name": "Consolas", "size": 17 },
  "padding": 24,
  "lineSpacing": 7,
  "separator": "=",
  "closeOnFocusLost": true,
  "footer": "Echap pour fermer   |   statique + synchro keybindings.json   |   doc : github.com/enixCode/quickref",
  "colors": {
    "background": [24, 24, 28],
    "foreground": [210, 210, 214],
    "accent": [96, 230, 150],
    "border": [96, 230, 150]
  },
  "grid": {
    "rows": 3,
    "cols": 3,
    "colGap": 46,
    "rowGap": 22,
    "cells": [
      {
        "row": 0, "col": 0, "title": "VSCODE (keybindings.json)",
        "source": {
          "file": "%APPDATA%/Code/User/keybindings.json",
          "regex": "\"key\"\\s*:\\s*\"([^\"]+)\"\\s*,\\s*\"command\"\\s*:\\s*\"([^\"]+)\"",
          "key": 1, "action": 2,
          "limit": 8,
          "replace": [
            { "find": "workbench\\.action\\.terminal\\.toggleTerminal", "to": "terminal" },
            { "find": "workbench\\.action\\.terminal\\.sendSequence", "to": "envoyer touche" },
            { "find": "workbench\\.action\\.navigateLeft", "to": "zone gauche" },
            { "find": "workbench\\.action\\.navigateRight", "to": "zone droite" },
            { "find": "workbench\\.action\\.navigateUp", "to": "zone haut" },
            { "find": "workbench\\.action\\.navigateDown", "to": "zone bas" },
            { "find": "workbench\\.view\\.explorer", "to": "explorateur" },
            { "find": "workbench\\.action\\.nextWindow", "to": "fenetre suivante" },
            { "find": "workbench\\.action\\.previousWindow", "to": "fenetre precedente" },
            { "find": "workbench\\.action\\.", "to": "" },
            { "find": "workbench\\.view\\.", "to": "" }
          ]
        }
      },
      {
        "row": 0, "col": 1, "title": "FICHIERS & RECHERCHE",
        "items": [
          "Ctrl+P = ouvrir un fichier",
          "Ctrl+Shift+P = palette de commandes",
          "Ctrl+Shift+F = recherche projet",
          "Ctrl+Tab = fichier suivant",
          "Ctrl+B = afficher/cacher sidebar",
          "Alt+Gauche / Droite = retour / avant"
        ]
      },
      {
        "row": 0, "col": 2, "title": "PANNEAUX",
        "items": [
          "Ctrl+1 / 2 = groupe d'editeurs",
          "Ctrl+K Z = mode zen",
          "Ctrl+, = parametres",
          "F11 = plein ecran",
          "F2 = renommer le symbole",
          "Ctrl+/ = commenter"
        ]
      },
      {
        "row": 1, "col": 0, "title": "VIM MOUVEMENT",
        "items": [
          "h j k l = gauche bas haut droite",
          "w / b = mot suivant / precedent",
          "gg / G = haut / bas du fichier",
          "0 / $ = debut / fin de ligne",
          "Ctrl+d / Ctrl+u = demi-page",
          "f<car> = saut au caractere"
        ]
      },
      {
        "row": 1, "col": 1, "title": "VIM EDITION",
        "items": [
          "i / a = inserer avant / apres",
          "o / O = ligne dessous / dessus",
          "dd = couper la ligne",
          "yy / p = copier / coller",
          "ciw = remplacer le mot",
          "u / Ctrl+r = annuler / refaire"
        ]
      },
      {
        "row": 1, "col": 2, "title": "RECHERCHE / REMPLACER",
        "items": [
          "/texte = chercher (bas)",
          "n / N = suivant / precedent",
          "* / # = mot sous curseur",
          ":s/a/b/g = remplacer la ligne",
          ":%s/a/b/g = remplacer tout le fichier",
          ":%s/a/b/gc = remplacer + confirmer",
          "Ctrl+Shift+H = remplacer multi-fichiers"
        ]
      },
      {
        "row": 2, "col": 0, "title": "VIM <C-w> (settings.json)",
        "source": {
          "file": "%APPDATA%/Code/User/settings.json",
          "regex": "\"before\"\\s*:\\s*\\[([^\\]]+)\\]\\s*,\\s*\"commands\"\\s*:\\s*\\[\\s*\"([^\"]+)\"",
          "key": 1, "action": 2,
          "limit": 10,
          "replace": [
            { "find": "[\"']", "to": "" },
            { "find": ",\\s*", "to": " " },
            { "find": "workbench\\.action\\.navigateLeft", "to": "zone gauche" },
            { "find": "workbench\\.action\\.navigateRight", "to": "zone droite" },
            { "find": "workbench\\.action\\.navigateUp", "to": "zone haut" },
            { "find": "workbench\\.action\\.navigateDown", "to": "zone bas" },
            { "find": "workbench\\.action\\.splitEditorDown", "to": "split ligne" },
            { "find": "workbench\\.action\\.splitEditor", "to": "split colonne" },
            { "find": "workbench\\.action\\.closeActiveEditor", "to": "fermer editeur" },
            { "find": "workbench\\.view\\.explorer", "to": "explorateur" },
            { "find": "workbench\\.action\\.", "to": "" },
            { "find": "workbench\\.view\\.", "to": "" }
          ]
        }
      }
    ]
  }
}
